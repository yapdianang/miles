+class TestBitmapCodec(CustomTestCase):
+    def test_round_trip_for_support_sizes_from_one_to_the_vocabulary(self):
+        generator = torch.Generator().manual_seed(0)
+        for vocab_size in (1000, 152576):
+            sizes = [1, 2, 7, 63, 64, 65, 999, OLD_CAP + 1, vocab_size - 1, vocab_size]
+            sets = [
+                torch.randperm(vocab_size, generator=generator)[:size].sort().values
+                for size in sizes
+            ]
+            sets.append(torch.tensor([0, vocab_size - 1]))
+            support = torch.stack([_support(vocab_size, ids) for ids in sets])
+            bitmap = pack_support_bitmap(support)
+            self.assertEqual(bitmap.dtype, torch.uint8)
+            self.assertEqual(tuple(bitmap.shape), (len(sets), bitmap_width(vocab_size)))
+            self.assertEqual(bitmap.shape[-1] % 8, 0)
+            ids, offsets = unpack_support_bitmap(bitmap.numpy())
+            for row, expected in enumerate(sets):
+                with self.subTest(vocab_size=vocab_size, size=len(expected)):
+                    np.testing.assert_array_equal(
+                        ids[offsets[row] : offsets[row + 1]], expected.numpy()
+                    )
+            self.assertEqual(ids.dtype, np.int32)
+
+    def test_leading_dimensions_and_empty_rows(self):
+        support = torch.zeros(2, 3, 130, dtype=torch.bool)
+        support[1, 2, [0, 64, 129]] = True
+        bitmap = pack_support_bitmap(support)
+        self.assertEqual(tuple(bitmap.shape), (2, 3, 24))
+        ids, offsets = unpack_support_bitmap(bitmap.reshape(6, -1).numpy())
+        self.assertEqual(offsets.tolist(), [0, 0, 0, 0, 0, 0, 3])
+        self.assertEqual(ids.tolist(), [0, 64, 129])
+
+    def test_token_bitmaps_match_packed_singletons(self):
+        tokens = torch.tensor([[0, 5], [127, 999]])
+        expected = torch.zeros(2, 2, 1000, dtype=torch.bool).scatter_(
+            -1, tokens.unsqueeze(-1), True
+        )
+        torch.testing.assert_close(
+            bitmap_from_tokens(tokens.to(torch.int32), 1000),
+            pack_support_bitmap(expected),
+        )
+
+    def test_members_fill_one_buffer_in_position_order(self):
+        support = torch.stack(
+            [_support(100, [3, 1]), _support(100, range(100)), _support(100, range(40))]
+        )
+        members, fits = support_members(support, budget=10)
+        # 3 * 10 + 100 entries: the first two rows fit, the third runs past.
+        self.assertEqual(members.numel(), 130)
+        expected = torch.nonzero(support.reshape(-1)).squeeze(1)
+        torch.testing.assert_close(members, expected[:130])
+        self.assertEqual(fits.tolist(), [True, True, False])
+
+    def test_one_position_can_span_the_vocabulary(self):
+        support = torch.stack(
+            [_support(152576, [9]), torch.ones(152576, dtype=torch.bool)]
+        )
+        members, fits = support_members(support, budget=4)
+        self.assertEqual(fits.tolist(), [True, True])
+        torch.testing.assert_close(
+            members[1 : 152576 + 1], torch.arange(152576) + 152576
+        )
+
+    def test_switch(self):
+        disagg = SimpleNamespace(disaggregation_mode="null")
+        with patch.object(support_bitmap, "get_disagg", return_value=disagg):
+            self.assertTrue(support_bitmap.support_bitmap_enabled())
+            with patch.dict(os.environ, {"SGLANG_SAMPLING_MASK_PACKED_IDS": "1"}):
+                self.assertFalse(support_bitmap.support_bitmap_enabled())
+            disagg.disaggregation_mode = "prefill"
+            self.assertFalse(support_bitmap.support_bitmap_enabled())
+
