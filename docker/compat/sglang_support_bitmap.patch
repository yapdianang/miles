+    def test_full_log_prob_buffer_aborts_only_positions_past_its_end(self):
+        generator = torch.Generator().manual_seed(2)
+        weights = _weights(generator, 3, 100, [100, 100, 2])
+        capture = _SamplingMaskCapture(
