+class TestSpeculativeBitmap(CustomTestCase):
+    def setUp(self):
+        override = get_context().override_server_args(sampling_mask_max_tokens=OLD_CAP)
+        override.install()
+        self.addCleanup(override.restore)
+
+    def _target_probs(self, generator, bs, draft, vocab_size, top_k):
+        logits = torch.randn(bs, draft, vocab_size, generator=generator)
+        kept = logits.topk(top_k, dim=-1)
+        probs = torch.zeros_like(logits).scatter_(
+            -1, kept.indices, kept.values.softmax(dim=-1)
+        )
+        return probs
+
+    def test_committed_rows_match_the_packed_path(self):
+        generator = torch.Generator().manual_seed(3)
+        bs, draft, vocab_size, top_k = 5, 4, 2000, 50
+        target_probs = self._target_probs(generator, bs, draft, vocab_size, top_k)
+        out_tokens = torch.multinomial(
+            target_probs.reshape(-1, vocab_size), 1, generator=generator
+        ).view(bs, draft)
+        commits = [1, 4, 2, 3, 4]
+        commit_lens = torch.tensor(commits)
+        # Rows 0, 2, 3 and 4 ask for masks, all but 3 in support mode; 2 is greedy.
+        batch_indices = torch.tensor([0, 2, 3, 4])
+        modes = ["support", None, "support", "selected", "support"]
+        greedy = torch.tensor([False, False, True, False, False])
+        out_tokens[2] = target_probs[2].argmax(dim=-1)
+        common = dict(
+            target_probs=target_probs,
+            batch_indices=batch_indices,
+            max_top_k=top_k,
+            greedy_mask=greedy,
+            support_capture_indices=torch.tensor([0, 1, 3]),
+        )
+        old = SpeculativeSamplingMaskCapture(**common).build_output(
+            out_tokens=out_tokens, commit_lens=commit_lens
+        )
+        new = SpeculativeSamplingMaskCapture(
+            **common, bitmap_vocab_size=vocab_size
+        ).build_output(out_tokens=out_tokens, commit_lens=commit_lens)
+        self.assertEqual(
+            tuple(new.token_ids.shape), (4, draft, bitmap_width(vocab_size))
+        )
+        # Each support-mode draft position budgets top_k entries, below the server limit.
+        self.assertEqual(new.support_logprobs.numel(), 3 * draft * top_k + vocab_size)
+        torch.testing.assert_close(
+            new.selected_logprobs, old.selected_logprobs, rtol=0, atol=0
+        )
+        old_rows = _materialize(old, modes)
+        new_rows = _materialize(new, modes)
+        self.assertEqual(
+            new_rows.next_token_sampling_mask_status,
+            old_rows.next_token_sampling_mask_status,
+        )
+        for row, mode in enumerate(modes):
+            if mode is None:
+                self.assertIsNone(new_rows.next_token_sampling_mask_idx[row])
+                continue
+            self.assertEqual(
+                len(new_rows.next_token_sampling_mask_idx[row]), commits[row]
+            )
+            for token in range(commits[row]):
+                with self.subTest(row=row, token=token):
+                    old_ids = old_rows.next_token_sampling_mask_idx[row][token]
+                    old_values = old_rows.next_token_sampling_logprobs[row][token]
+                    new_ids = new_rows.next_token_sampling_mask_idx[row][token]
+                    new_values = new_rows.next_token_sampling_logprobs[row][token]
+                    if mode == "support":
+                        ids, values = _by_id(old_ids, old_values)
+                    else:
+                        ids, values = sorted(old_ids.tolist()), old_values
+                    self.assertEqual(new_ids.tolist(), ids)
+                    np.testing.assert_array_equal(new_values, values)
+        self.assertEqual(
+            [ids.tolist() for ids in new_rows.next_token_sampling_mask_idx[2]],
+            [[out_tokens[2, token].item()] for token in range(2)],
+        )
+
+    def test_uncommitted_positions_take_no_buffer(self):
