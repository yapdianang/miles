+import os
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import numpy as np
+import torch
+
+from sglang.srt.layers.logits_processor import LogitsProcessorOutput, SamplingMaskStatus
+from sglang.srt.layers.sampler import Sampler, _SamplingMaskCapture
+from sglang.srt.managers.rollout_records import selected_logprobs_chunk
+from sglang.srt.managers.scheduler_components.batch_result_processor import (
+    SchedulerBatchResultProcessor,
+)
+from sglang.srt.runtime_context import get_context
+from sglang.srt.sampling import support_bitmap
+from sglang.srt.sampling.sampling_mask import SamplingMaskRows
+from sglang.srt.sampling.support_bitmap import (
+    bitmap_from_tokens,
+    bitmap_width,
+    pack_support_bitmap,
+    support_members,
+    unpack_support_bitmap,
+)
+from sglang.srt.speculative.spec_sampling_mask import SpeculativeSamplingMaskCapture
+from sglang.test.test_utils import CustomTestCase
+
+OLD_CAP = 4096
+
+
+def _support(vocab_size: int, ids) -> torch.Tensor:
+    support = torch.zeros(vocab_size, dtype=torch.bool)
+    support[torch.as_tensor(ids, dtype=torch.long)] = True
+    return support
+
+
+def _materialize(output, modes):
+    """Host rows through the result processor; modes holds None for rows without masks."""
+    reqs = [
+        SimpleNamespace(
+            return_sampling_mask=mode is not None, sampling_logprobs_mode=mode
+        )
+        for mode in modes
+    ]
+    logits_output = LogitsProcessorOutput(
+        next_token_logits=None, sampling_mask_output=output
+    )
+    SchedulerBatchResultProcessor.materialize_sampling_mask_output(reqs, logits_output)
+    return logits_output
+
+
+def _by_id(ids, values):
+    """Support ids and their values, ordered by id."""
+    order = np.argsort(np.asarray(ids), kind="stable")
+    return np.asarray(ids)[order].tolist(), np.asarray(values)[order]
+
+
+def _weights(generator, rows: int, vocab_size: int, sizes) -> torch.Tensor:
+    """Post-filter weights with the given support sizes and distinct values."""
+    weights = torch.zeros(rows, vocab_size)
+    for row, size in enumerate(sizes):
+        ids = torch.randperm(vocab_size, generator=generator)[:size]
+        weights[row, ids] = torch.rand(size, generator=generator) + 0.01
+    return weights
+
