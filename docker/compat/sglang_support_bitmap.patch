+class TestSamplerBitmap(CustomTestCase):
+    def _build(self, bitmap, cap, capture, tokens, support_rows):
+        return _sampler(bitmap, cap)._build_sampling_mask_output(
+            tokens, capture, support_capture_indices=support_rows
+        )
+
+    def test_rows_and_logprobs_match_the_packed_path(self):
+        generator = torch.Generator().manual_seed(1)
+        vocab_size = 3000
+        weights = _weights(generator, 4, vocab_size, [1, 5, 300, 2999])
+        tokens = torch.multinomial(weights, 1, generator=generator).squeeze(1)
+        modes = ["support", "selected", "support", "support"]
+        support_rows = torch.tensor([0, 2, 3])
+        sorted_weights, sorted_ids = weights.sort(dim=-1, descending=True)
+        producers = {
+            "id order": dict(weights=weights, token_ids=None),
+            "sorted": dict(
+                weights=sorted_weights, token_ids=sorted_ids.to(torch.int32)
+            ),
+        }
+        for name, producer in producers.items():
+            for selected_weight in (
+                None,
+                weights.gather(1, tokens[:, None]).squeeze(1),
+            ):
+                with self.subTest(producer=name, synced=selected_weight is None):
+                    capture = _SamplingMaskCapture(
+                        batch_rows=torch.arange(4),
+                        selected_weight=selected_weight,
+                        **producer,
+                    )
+                    old = self._build(False, vocab_size, capture, tokens, support_rows)
+                    new = self._build(True, OLD_CAP, capture, tokens, support_rows)
+                    self.assertEqual(new.token_ids.dtype, torch.uint8)
+                    torch.testing.assert_close(
+                        new.selected_logprobs, old.selected_logprobs, rtol=0, atol=0
+                    )
+                    old_rows = _materialize(old, modes)
+                    new_rows = _materialize(new, modes)
+                    self.assertEqual(
+                        new_rows.next_token_sampling_mask_status,
+                        [SamplingMaskStatus.OK] * 4,
+                    )
+                    self.assertEqual(
+                        old_rows.next_token_sampling_mask_status,
+                        new_rows.next_token_sampling_mask_status,
+                    )
+                    for row, mode in enumerate(modes):
+                        old_ids = old_rows.next_token_sampling_mask_idx[row]
+                        values = old_rows.next_token_sampling_logprobs[row]
+                        if mode == "support":
+                            ids, values = _by_id(old_ids, values)
+                        else:
+                            ids = sorted(old_ids.tolist())
+                        self.assertEqual(
+                            new_rows.next_token_sampling_mask_idx[row].tolist(), ids
+                        )
+                        # Bitwise equal: the same float32 division and log.
+                        np.testing.assert_array_equal(
+                            new_rows.next_token_sampling_logprobs[row], values
+                        )
+
+    def test_bitmaps_have_no_cap(self):
+        vocab_size = 9000
+        weights = torch.full((1, vocab_size), 1.0 / vocab_size)
+        capture = _SamplingMaskCapture(
+            batch_rows=torch.tensor([0]),
+            weights=weights,
+            token_ids=None,
+            selected_weight=None,
+        )
+        tokens = torch.tensor([8999])
+        for mode, support_rows in (("selected", None), ("support", torch.tensor([0]))):
+            with self.subTest(mode=mode):
+                old = self._build(False, OLD_CAP, capture, tokens, support_rows)
+                self.assertEqual(old.statuses.tolist(), [SamplingMaskStatus.OVERFLOW])
+                rows = _materialize(
+                    self._build(True, OLD_CAP, capture, tokens, support_rows), [mode]
+                )
+                self.assertEqual(
+                    rows.next_token_sampling_mask_status, [SamplingMaskStatus.OK]
+                )
+                self.assertEqual(
+                    rows.next_token_sampling_mask_idx[0].tolist(),
+                    list(range(vocab_size)),
+                )
+                if mode == "support":
+                    np.testing.assert_allclose(
+                        rows.next_token_sampling_logprobs[0],
+                        np.full(
+                            vocab_size, np.log(np.float32(1.0 / vocab_size)), np.float32
+                        ),
