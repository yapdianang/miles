+    def test_rows_reach_the_host_queue_as_packed_rows_do(self):
+        """Request queues and rollout records see the same sparse rows, ids reordered."""
+        generator = torch.Generator().manual_seed(6)
+        weights = _weights(generator, 2, 500, [7, 300])
+        tokens = torch.multinomial(weights, 1, generator=generator).squeeze(1)
+        capture = _SamplingMaskCapture(
