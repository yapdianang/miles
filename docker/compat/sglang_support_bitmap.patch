+def _sampler(bitmap: bool, cap: int) -> Sampler:
+    sampler = Sampler.__new__(Sampler)
+    torch.nn.Module.__init__(sampler)
+    sampler.support_bitmap = bitmap
+    sampler.sampling_mask_max_tokens = cap
+    sampler.tp_sync_group = None
+    sampler.cp_sync_group = None
+    return sampler
