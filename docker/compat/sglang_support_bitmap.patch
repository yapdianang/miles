+
+    def _build_bitmap_output(
+        self,
+        output_tokens: torch.Tensor,
+        num_accept_tokens: torch.Tensor,
+        greedy_mask: torch.Tensor | None,
+    ) -> SamplingMaskOutput:
+        """Full-vocabulary bitmaps [rows, draft, W]; support-mode log-probs of
+        the committed positions share one buffer, in row and token order."""
+        vocab_size = self.bitmap_vocab_size
+        num_rows, num_draft = output_tokens.shape
+        tokens = output_tokens.long()
+        if self.target_probs is None or greedy_mask is not None:
+            singletons = torch.zeros(
+                (num_rows, num_draft, vocab_size),
+                dtype=torch.bool,
+                device=output_tokens.device,
+            ).scatter_(-1, tokens.unsqueeze(-1), True)
+        if self.target_probs is None:
+            support = singletons
+            selected_logprobs = torch.zeros_like(output_tokens, dtype=torch.float32)
+        else:
+            support = (self.target_probs > 0).index_select(0, self.batch_indices)
+            positions = torch.arange(num_draft, device=output_tokens.device)
+            selected_logprobs = torch.log(
+                self.target_probs[self.batch_indices[:, None], positions, tokens]
+            )
+            if greedy_mask is not None:
+                support = torch.where(greedy_mask[:, None, None], singletons, support)
+                selected_logprobs = torch.where(
+                    greedy_mask[:, None],
+                    torch.zeros_like(selected_logprobs),
+                    selected_logprobs,
+                )
+
+        overflow = torch.zeros_like(output_tokens, dtype=torch.bool)
+        support_logprobs = None
+        if self.support_capture_indices is not None:
+            rows = self.support_capture_indices
+            committed = torch.arange(
+                num_draft, device=output_tokens.device
+            ) < num_accept_tokens.index_select(0, rows).unsqueeze(-1)
+            members, fits = support_members(
+                support.index_select(0, rows) & committed.unsqueeze(-1),
+                min(get_exec().features.sampling_mask_max_tokens, self.max_top_k),
+            )
+            overflow[rows] = ~fits & committed
+            position = members // vocab_size
+            if self.target_probs is None:
+                support_logprobs = torch.zeros_like(members, dtype=torch.float32)
+            else:
+                row = rows[position // num_draft]
+                support_logprobs = torch.log(
+                    self.target_probs[
