diff --git a/python/sglang/srt/sampling/support_bitmap.py b/python/sglang/srt/sampling/support_bitmap.py
new file mode 100644
index 0000000000..90fdf15de7
--- /dev/null
+++ b/python/sglang/srt/sampling/support_bitmap.py
@@ -0,0 +1,132 @@
+"""Sampling supports as full-vocabulary bitmaps.
+
+The device packs each support into a bitmap of fixed shape and full vocabulary width, so the
+device-to-host copy needs no synchronization and never truncates a support, even one that spans
+the vocabulary. The host unpacks the bitmaps to sparse token ids. Support-mode log-probs share one
+buffer of ``positions * budget + vocab_size`` entries per batch, positions in order and ids
+ascending, where budget is --sampling-mask-max-tokens (DFlash: at most the batch's top_k). A
+position may take the room others leave, so a support that spans the vocabulary always fits
+while the other positions keep within their budget.
+"""
+
+from typing import List, Optional, Sequence, Tuple
+
+import numpy as np
+import torch
+
+from sglang.srt.runtime_context import get_disagg
+from sglang.srt.utils.common import get_bool_env_var
+
+
+def support_bitmap_enabled() -> bool:
+    """Bitmaps unless SGLANG_SAMPLING_MASK_PACKED_IDS=1. Disaggregated serving keeps packed ids:
+    its prefill-to-decode buffer holds at most --sampling-mask-max-tokens ids per token.
+    """
+    return (
+        not get_bool_env_var("SGLANG_SAMPLING_MASK_PACKED_IDS")
+        and get_disagg().disaggregation_mode == "null"
+    )
+
+
+def bitmap_width(vocab_size: int) -> int:
+    """Bytes per bitmap, in whole 64-bit words for the host scan."""
+    return -(-vocab_size // 64) * 8
+
+
+def pack_support_bitmap(support: torch.Tensor) -> torch.Tensor:
+    """bool [..., V] -> uint8 [..., bitmap_width(V)]; bit b of byte j marks token 8 * j + b."""
+    vocab_size = support.shape[-1]
+    width = bitmap_width(vocab_size)
+    bits = support.to(torch.uint8)
+    if width * 8 != vocab_size:
+        bits = torch.nn.functional.pad(bits, (0, width * 8 - vocab_size))
+    shifts = torch.arange(8, dtype=torch.uint8, device=support.device)
+    return (bits.reshape(*support.shape[:-1], width, 8) << shifts).sum(
+        dim=-1, dtype=torch.uint8
+    )
+
+
+def bitmap_from_tokens(token_ids: torch.Tensor, vocab_size: int) -> torch.Tensor:
+    """Singleton supports: int [...] -> uint8 [..., bitmap_width(V)]."""
+    tokens = token_ids.long().unsqueeze(-1)
+    bitmap = torch.zeros(
+        (*token_ids.shape, bitmap_width(vocab_size)),
+        dtype=torch.uint8,
+        device=token_ids.device,
+    )
+    return bitmap.scatter_(-1, tokens // 8, (1 << (tokens % 8)).to(torch.uint8))
+
+
+def support_members(
+    support: torch.Tensor, budget: int
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Flat indices into ``support`` [..., V] of its members, positions in order and ids ascending,
+    filling a buffer of positions * budget + V entries. ``fits`` [...] is False where a
+    position's members run past the buffer."""
+    vocab_size = support.shape[-1]
+    size = support.numel() // vocab_size * budget + vocab_size
+    members = torch.nonzero_static(support.reshape(-1), size=size, fill_value=0)
+    ends = support.sum(dim=-1).reshape(-1).cumsum(dim=0)
+    return members.squeeze(1), (ends <= size).view(support.shape[:-1])
+
+
+def unpack_support_bitmap(bitmap: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
+    """uint8 [rows, W] -> (int32 ids, int64 offsets [rows + 1]); row r's ids, ascending, are
+    ``ids[offsets[r]:offsets[r + 1]]``. Only nonzero 64-bit words are expanded."""
+    words = np.ascontiguousarray(bitmap).view("<u8")
+    rows, columns = np.nonzero(words)
+    bits = np.unpackbits(
+        words[rows, columns].view(np.uint8).reshape(-1, 8), axis=-1, bitorder="little"
+    )
+    hits, bit = np.nonzero(bits)
+    ids = (columns[hits] * 64 + bit).astype(np.int32)
+    offsets = np.zeros(len(words) + 1, dtype=np.int64)
+    np.cumsum(np.bincount(rows[hits], minlength=len(words)), out=offsets[1:])
+    return ids, offsets
+
+
+def unpack_sampling_masks(
+    bitmap: np.ndarray,
+    returns_support_logprobs: Sequence[bool],
+    support_logprobs: Optional[np.ndarray],
+    num_accept_tokens: Optional[Sequence[int]] = None,
+) -> Tuple[list, list, list]:
+    """Host rows of a bitmap SamplingMaskOutput: per mask row its support ids and lengths, and per
+    support-mode row its log-probs, cut from the shared buffer in device order. Speculative bitmaps
+    [rows, draft, W] keep each row's first num_accept_tokens positions, as lists over tokens.
+    """
+    speculative = num_accept_tokens is not None
+    counts = np.asarray(
+        num_accept_tokens if speculative else [1] * len(bitmap), dtype=np.int64
+    )
+    positions = bitmap
+    if speculative:
+        rows = np.repeat(np.arange(len(bitmap)), counts)
+        tokens = np.arange(len(rows)) - np.repeat(np.cumsum(counts) - counts, counts)
+        positions = bitmap[rows, tokens]
+    ids, offsets = unpack_support_bitmap(positions)
+    supports = [ids[offsets[i] : offsets[i + 1]] for i in range(len(positions))]
+    lengths = np.diff(offsets).tolist()
+    support_rows = np.asarray(returns_support_logprobs, dtype=bool)
+    logprobs = []
+    if support_logprobs is not None:
+        end = 0
+        for keep, length in zip(np.repeat(support_rows, counts).tolist(), lengths):
+            if keep:
+                # A position past the buffer end is OVERFLOW and never read.
+                logprobs.append(support_logprobs[end : end + length])
+                end += length
+    if not speculative:
+        return supports, lengths, logprobs
+    counts = counts.tolist()
+    support_counts = [count for count, keep in zip(counts, support_rows) if keep]
+    return (
+        _group(supports, counts),
+        _group(lengths, counts),
+        _group(logprobs, support_counts),
+    )
+
+
+def _group(values: list, counts: List[int]) -> List[list]:
+    ends = np.cumsum(counts, dtype=np.int64).tolist()
+    return [values[end - count : end] for count, end in zip(counts, ends)]
