+import unittest
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+
+from sglang.srt.disaggregation.utils import DisaggregationMode
+from sglang.srt.environ import envs
+from sglang.srt.managers.io_struct import (
+    CollectRolloutRecordsReqOutput,
+    msgpack_decode,
+    msgpack_encode,
+)
+from sglang.srt.managers.rollout_records import (
+    RolloutRecord,
+    RolloutRecordPool,
+    selected_logprobs_chunk,
+)
+from sglang.srt.managers.schedule_batch import FINISH_ABORT, FINISH_LENGTH
+from sglang.srt.managers.scheduler_components.output_streamer import (
+    _GenerationStreamAccumulator,
+)
+from sglang.srt.sampling.sampling_mask import SamplingMaskChunk, SamplingMaskRows
+from sglang.srt.speculative.spec_info import SpeculativeAlgorithm
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+# Output tokens 7, 8, 9; each support row lists the sampled token among its candidates.
+OUTPUT_IDS = [7, 8, 9]
+SUPPORT_IDS = [[3, 7], [8], [9, 4, 5]]
+SUPPORT_LOGPROBS = [[-1.0, -0.5], [0.0], [-0.25, -2.0, -3.0]]
+
+
+def _record(num_bytes: int) -> RolloutRecord:
+    return RolloutRecord(routes=np.zeros(num_bytes // 2, dtype=np.int16))
+
+
+class _FakeReq:
+    def __init__(self, *, finished_reason=None, return_sampling_mask=True, keep=True):
+        self.rid = "seq-1"
+        self.http_worker_ipc = None
+        self.finished_reason = finished_reason
+        self.finished_output = False
+        self.finished_len = None
+        self.stream = False
+        self.sampling_params = SimpleNamespace(
+            max_new_tokens=8,
+            stream_interval=None,
+            skip_special_tokens=True,
+            spaces_between_special_tokens=True,
+            no_stop_trim=False,
+        )
+        self.output_ids = list(OUTPUT_IDS)
+        self.output_ids_through_stop = list(OUTPUT_IDS)
+        self.send_token_offset = 0
+        self.send_output_token_logprobs_offset = 0
+        self.send_decode_id_offset = 0
+        self.decoded_text = ""
+        self.origin_input_ids = [1, 2]
+        self.reasoning_tokens = 0
+        self.cached_tokens = 0
+        self.retraction_count = 0
+        self.time_stats = None
+        self.weight_version_events = []
+        self.mm_image_tokens = 0
+        self.mm_audio_tokens = 0
+        self.mm_video_tokens = 0
+        self.multimodal_inputs = None
+        self.customized_info = None
+        self.is_retracted = False
+        self.beam_group = None
+        self.return_logprob = False
+        self.return_hidden_states = False
+        self.return_indexer_topk = False
+        self.return_routed_experts = True
+        self.keep_rollout_record = keep
+        self.routed_experts_start_len = 1
+        # The scheduler gathers rows [start_len, seqlen - 1) when the request finishes.
+        self.routed_experts = (
+            torch.arange(3 * 2 * 4, dtype=torch.int32).view(3, 2, 4)
+            if finished_reason is not None
+            else None
+        )
+        self.return_sampling_mask = return_sampling_mask
+        self.sampling_logprobs_mode = "support"
+        self.sampling_mask_rows = SamplingMaskRows() if return_sampling_mask else None
+        for ids, logprobs in zip(SUPPORT_IDS, SUPPORT_LOGPROBS):
+            if return_sampling_mask:
+                self.sampling_mask_rows.append(
+                    np.array(ids, dtype=np.int32), np.array(logprobs, dtype=np.float32)
+                )
+
+    def finished(self):
+        return self.finished_reason is not None
+
+    def init_incremental_detokenize(self):
+        return self.output_ids_through_stop, 0
+
+
+def _accumulator(pool: RolloutRecordPool) -> _GenerationStreamAccumulator:
+    return _GenerationStreamAccumulator(
+        return_logprob=False,
+        return_hidden_states=False,
+        return_routed_experts=True,
+        return_indexer_topk=False,
+        return_sampling_mask=True,
+        spec_algorithm=SpeculativeAlgorithm.NONE,
+        disaggregation_mode=DisaggregationMode.NULL,
+        default_stream_interval=1,
+        default_force_stream_interval=1,
+        get_cached_tokens_details=lambda req: None,
+        current_weight_version=None,
+        rollout_records=pool,
+    )
+
+
+class TestRolloutRecordPool(unittest.TestCase):
+    def test_collect_returns_each_record_once(self):
+        pool = RolloutRecordPool(max_bytes=1 << 20)
+        pool.put("a", _record(16))
+        pool.put("b", _record(32))
+        records = pool.collect(["a", "missing"])
+        self.assertEqual(list(records), ["a"])
+        self.assertEqual(pool.collect(["a"]), {})
+        self.assertEqual((len(pool), pool.num_bytes), (1, 32))
+
+    def test_the_oldest_records_leave_first_over_budget(self):
+        pool = RolloutRecordPool(max_bytes=64)
+        for rid in "abc":
+            pool.put(rid, _record(32))
+        self.assertEqual(list(pool.collect(["a", "b", "c"])), ["b", "c"])
+        self.assertEqual(pool.num_evicted, 1)
+
+    def test_a_record_over_budget_is_kept_alone(self):
+        pool = RolloutRecordPool(max_bytes=8)
+        pool.put("a", _record(16))
+        pool.put("b", _record(16))
+        self.assertEqual(list(pool.collect(["a", "b"])), ["b"])
+
+    def test_clear_drops_everything(self):
+        pool = RolloutRecordPool(max_bytes=1 << 20)
+        pool.put("a", _record(16))
+        pool.clear()
+        self.assertEqual((len(pool), pool.num_bytes), (0, 0))
+
+    def test_records_cross_the_ipc_boundary(self):
+        supports = SamplingMaskChunk(
+            lengths=np.array([2], dtype=np.int32),
+            token_ids=np.array([3, 7], dtype=np.int32),
+            logprobs=np.array([-1.0, -0.5], dtype=np.float32),
+        )
+        output = CollectRolloutRecordsReqOutput(
+            records={
+                "a": RolloutRecord(
+                    routes_start=4,
+                    routes=np.ones((1, 2, 3), np.int16),
+                    supports=supports,
+                )
+            },
+        )
+        record = msgpack_decode(msgpack_encode(output)).records["a"]
+        self.assertEqual(record.routes_start, 4)
+        np.testing.assert_array_equal(record.routes, np.ones((1, 2, 3), np.int16))
+        np.testing.assert_array_equal(record.supports.token_ids, [3, 7])
+
+
+class TestSelectedLogprobs(unittest.TestCase):
+    def test_support_rows_reduce_to_the_sampled_token(self):
+        rows = SamplingMaskRows()
+        for ids, logprobs in zip(SUPPORT_IDS, SUPPORT_LOGPROBS):
+            rows.append(np.array(ids, np.int32), np.array(logprobs, np.float32))
+        chunk = selected_logprobs_chunk(
+            rows.view(), np.array(OUTPUT_IDS), support_logprobs=True
+        )
+        np.testing.assert_allclose(chunk.logprobs, [-0.5, 0.0, -0.25])
+        self.assertEqual(chunk.to_lists(support_logprobs=False)[1], [-0.5, 0.0, -0.25])
+
+    def test_selected_rows_pass_through(self):
+        chunk = SamplingMaskChunk(
+            lengths=np.array([1], np.int32),
+            token_ids=np.array([7], np.int32),
+            logprobs=np.array([-0.3], np.float32),
+        )
+        result = selected_logprobs_chunk(chunk, np.array([7]), support_logprobs=False)
+        np.testing.assert_allclose(result.logprobs, [-0.3])
+
+
+class TestStreamerKeepsRecords(unittest.TestCase):
+    def test_an_unfinished_request_streams_no_rows_and_keeps_them_queued(self):
+        pool = RolloutRecordPool(max_bytes=1 << 20)
+        accumulator = _accumulator(pool)
+        req = _FakeReq()
+        accumulator.accept(req=req)
+        self.assertEqual(len(accumulator.output_token_sampling_mask[0].lengths), 0)
+        self.assertEqual(accumulator.routed_experts, [None])
+        self.assertEqual(len(req.sampling_mask_rows.view().lengths), 3)
+        self.assertEqual(len(pool), 0)
+
+    def test_a_finished_request_leaves_routes_and_supports_in_the_pool(self):
+        pool = RolloutRecordPool(max_bytes=1 << 20)
+        accumulator = _accumulator(pool)
+        req = _FakeReq(finished_reason=FINISH_LENGTH(length=3))
+        expected_routes = req.routed_experts.numpy().astype(np.int16)
+        accumulator.accept(req=req)
+        self.assertEqual(accumulator.routed_experts, [None])
+        chunk = accumulator.output_token_sampling_mask[0]
+        np.testing.assert_allclose(chunk.logprobs, [-0.5, 0.0, -0.25])
+        self.assertEqual(len(chunk.token_ids), 0)
+        record = pool.collect(["seq-1"])["seq-1"]
+        self.assertEqual(record.routes_start, 1)
+        self.assertEqual(record.routes.dtype, np.int16)
+        np.testing.assert_array_equal(record.routes, expected_routes)
+        self.assertEqual(
+            record.supports.to_lists(support_logprobs=True),
+            (SUPPORT_IDS, SUPPORT_LOGPROBS),
+        )
+
+    def test_routes_alone_are_kept_without_a_sampling_mask(self):
+        pool = RolloutRecordPool(max_bytes=1 << 20)
+        req = _FakeReq(
+            finished_reason=FINISH_LENGTH(length=3), return_sampling_mask=False
+        )
+        _accumulator(pool).accept(req=req)
+        record = pool.collect(["seq-1"])["seq-1"]
+        self.assertIsNone(record.supports)
+        self.assertEqual(record.routes.shape, (3, 2, 4))
+
+    def test_an_aborted_request_keeps_nothing(self):
+        pool = RolloutRecordPool(max_bytes=1 << 20)
+        req = _FakeReq(finished_reason=FINISH_ABORT("aborted"))
+        _accumulator(pool).accept(req=req)
+        self.assertEqual(len(pool), 0)
+
+    def test_also_return_keeps_and_returns_the_full_record(self):
+        pool = RolloutRecordPool(max_bytes=1 << 20)
+        accumulator = _accumulator(pool)
+        req = _FakeReq(finished_reason=FINISH_LENGTH(length=3))
+        with envs.SGLANG_ROLLOUT_RECORDS_ALSO_RETURN.override(True):
+            accumulator.accept(req=req)
+        masks, _ = accumulator.output_token_sampling_mask[0].to_lists(
+            support_logprobs=True
+        )
+        self.assertEqual(masks, SUPPORT_IDS)
+        self.assertEqual(tuple(accumulator.routed_experts[0].shape), (3, 2, 4))
+        record = pool.collect(["seq-1"])["seq-1"]
+        self.assertEqual(
+            record.supports.to_lists(support_logprobs=True)[0], SUPPORT_IDS
+        )
+
+    def test_a_request_that_does_not_keep_returns_everything(self):
+        pool = RolloutRecordPool(max_bytes=1 << 20)
+        accumulator = _accumulator(pool)
+        req = _FakeReq(finished_reason=FINISH_LENGTH(length=3), keep=False)
+        accumulator.accept(req=req)
+        masks, _ = accumulator.output_token_sampling_mask[0].to_lists(
+            support_logprobs=True
+        )
+        self.assertEqual(masks, SUPPORT_IDS)
+        self.assertEqual(tuple(accumulator.routed_experts[0].shape), (3, 2, 4))
+        self.assertEqual(len(pool), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
