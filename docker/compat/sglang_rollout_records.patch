diff --git a/python/sglang/srt/managers/rollout_records.py b/python/sglang/srt/managers/rollout_records.py
new file mode 100644
index 0000000..a818f33
--- /dev/null
+++ b/python/sglang/srt/managers/rollout_records.py
@@ -0,0 +1,85 @@
+"""Routed experts and sampling supports kept on the host until a trainer collects them.
+
+With ``--rollout-record-cache-gb``, a finished request that asked for routed experts or a
+sampling mask leaves them here under its rid instead of in its response; the response keeps
+only each output token's selected log-probability. ``/collect_rollout_records`` returns the
+records of a rollout once and drops them.
+"""
+
+from collections import OrderedDict
+from typing import Dict, List, Optional
+
+import msgspec
+import numpy as np
+
+from sglang.srt.sampling.sampling_mask import SamplingMaskChunk
+
+
+class RolloutRecord(msgspec.Struct, array_like=True, kw_only=True):
+    # The request's routed_experts_start_len: routes cover positions [routes_start, seqlen - 1).
+    routes_start: int = 0
+    # int16 [rows, layers, topk]
+    routes: Optional[np.ndarray] = None
+    # One support row per output token, as the response would have carried it.
+    supports: Optional[SamplingMaskChunk] = None
+
+    @property
+    def nbytes(self) -> int:
+        arrays = [self.routes]
+        if self.supports is not None:
+            supports = self.supports
+            arrays += [supports.lengths, supports.token_ids, supports.logprobs]
+        return sum(array.nbytes for array in arrays if array is not None)
+
+
+def selected_logprobs_chunk(
+    supports: SamplingMaskChunk, output_ids: np.ndarray, support_logprobs: bool
+) -> SamplingMaskChunk:
+    """Rows without token ids whose log-probability is that of the sampled token."""
+    logprobs = supports.logprobs
+    if support_logprobs:
+        sampled = np.repeat(
+            output_ids[: len(supports.lengths)].astype(np.int32), supports.lengths
+        )
+        logprobs = logprobs[supports.token_ids == sampled]
+    return SamplingMaskChunk(
+        lengths=np.zeros(len(logprobs), dtype=np.int32),
+        token_ids=np.empty(0, dtype=np.int32),
+        logprobs=np.ascontiguousarray(logprobs, dtype=np.float32),
+    )
+
+
+class RolloutRecordPool:
+    """Records by rid; the oldest leave first once they exceed ``max_bytes``."""
+
+    def __init__(self, max_bytes: int) -> None:
+        self.max_bytes = max_bytes
+        self.num_bytes = 0
+        self.num_evicted = 0
+        self._records: "OrderedDict[str, RolloutRecord]" = OrderedDict()
+
+    def __len__(self) -> int:
+        return len(self._records)
+
+    def put(self, rid: str, record: RolloutRecord) -> None:
+        previous = self._records.pop(rid, None)
+        if previous is not None:
+            self.num_bytes -= previous.nbytes
+        self._records[rid] = record
+        self.num_bytes += record.nbytes
+        while self.num_bytes > self.max_bytes and len(self._records) > 1:
+            self.num_bytes -= self._records.popitem(last=False)[1].nbytes
+            self.num_evicted += 1
+
+    def collect(self, rids: List[str]) -> Dict[str, RolloutRecord]:
+        records = {}
+        for rid in rids:
+            record = self._records.pop(rid, None)
+            if record is not None:
+                self.num_bytes -= record.nbytes
+                records[rid] = record
+        return records
+
+    def clear(self) -> None:
+        self._records.clear()
+        self.num_bytes = 0
